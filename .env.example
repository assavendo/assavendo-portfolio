# ───────────── Site ─────────────
# OBLIGATOIRE en production : adresse publique complète en https (canoniques, sitemap, données structurées).
# Le build échoue si elle est absente ou pointe vers localhost.
NEXT_PUBLIC_SITE_URL=https://assavendo.vercel.app

# ───────────── Supabase (Project Settings > API) ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur uniquement, jamais NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# ───────────── Stripe (commencer par les clés de test) ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "true" après activation de Stripe Tax dans le tableau de bord Stripe (TVA calculée automatiquement)
STRIPE_TAX_ENABLED=false

# ───────────── E-mails (Resend) ─────────────
# Clé de chiffrement des credentials IA (32 octets en base64) : générer hors ligne puis conserver uniquement dans les secrets Vercel. Ne jamais la versionner.
AI_MASTER_KEY=
# Secret Vercel Cron pour protéger /api/ai/cron (serveur uniquement).
CRON_SECRET=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ───────────── Anti-spam (Cloudflare Turnstile) ─────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ───────────── Photos sous licence (Unsplash) ─────────────
UNSPLASH_ACCESS_KEY=

# ───────────── Outil « test de vitesse » (Google PageSpeed Insights) ─────────────
# Facultative (quota partagé sans clé) ; recommandée en production : clé gratuite « PageSpeed Insights API ».
PAGESPEED_API_KEY=

# ───────────── Vie privée ─────────────
# Sel des empreintes d'adresses IP (consentements, journal de téléchargement). Longue chaîne aléatoire, jamais modifiée après coup.
IP_HASH_SALT=

# ───────────── Mentions légales (OBLIGATOIRES avant l'ouverture commerciale) ─────────────
LEGAL_NAME=
LEGAL_FORM=
LEGAL_SIRET=
LEGAL_VAT=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_DIRECTOR=
# Hébergeur (valeur par défaut : Vercel)
LEGAL_HOST=
