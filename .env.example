# Site
NEXT_PUBLIC_SITE_URL=https://assavendo.fr

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur uniquement, jamais NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Stripe (commencer par les clés de test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails (Resend) : réception des messages de contact et accusés
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Anti-spam (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Photos sous licence (Unsplash) : recherche dans l'administration
UNSPLASH_ACCESS_KEY=

# Outils : API PageSpeed (optionnelle)
PAGESPEED_API_KEY=
